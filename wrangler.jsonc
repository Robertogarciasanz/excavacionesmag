// Configuración de Cloudflare Workers para excavacionesmag.es
// Solo se publica el contenido de la carpeta "public".
{
  "name": "excavacionesmag",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  },
  // Dominios propios: Cloudflare crea los registros DNS y el certificado al desplegar.
  "routes": [
    { "pattern": "excavacionesmag.es", "custom_domain": true },
    { "pattern": "www.excavacionesmag.es", "custom_domain": true }
  ]
}
